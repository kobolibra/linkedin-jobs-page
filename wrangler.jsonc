{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkedin",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "durable_objects": {
    "bindings": [{"name": "VISITS", "class_name": "VisitorCounter"}]
  },
  "migrations": [{"tag": "visitor-counter-v1", "new_sqlite_classes": ["VisitorCounter"]}],
  "build": {"command": "node scripts/build_jd_shards.mjs"},
  "assets": {
    "directory": "./public-assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/"]
  }
}
